#!/bin/zsh
# Переключатель проектов — prefix f во всплывающем окне tmux.
# Сверху открытые сессии (последняя посещённая — первой, текущая не
# показывается), затем сессии прошлого запуска из снимка dev (○), ниже
# каталоги проектов, для которых сессии ещё нет.
# Enter — перейти; сессия из снимка восстанавливается через `dev -r`, для
# каталога сессия создаётся через `dev` с теми же окнами
# editor/server/tests/…; Ctrl-X — закрыть выбранную сессию.
# Справа превью: экран сессии, её окна и каталоги из снимка, или git log
# и содержимое каталога.
#
# Где искать проекты — $DEV_PROJECT_ROOTS (через пробел), по умолчанию
# ~/workspace и ~/Projects: их подкаталоги, git-репозитории уровнем ниже и
# worktree задач из .worktrees.

emulate -L zsh
path=(/opt/homebrew/bin $path)   # popup живёт в окружении сервера tmux

self=${0:A}
dev=${0:A:h}/dev
roots=(${=DEV_PROJECT_ROOTS:-$HOME/workspace $HOME/Projects})
snapshot_file=${XDG_STATE_HOME:-$HOME/.local/state}/dev/sessions
tab=$'\t'

# Строки для fzf: "вид<TAB>как показать<TAB>сессия или каталог".
list() {
  local current line name dir
  local -A open
  local -aU dirs
  current=$(tmux display -p '#S')
  for line in ${(f)"$(tmux list-sessions -F '#{session_last_attached} #{session_name}' 2>/dev/null | sort -rn)"}; do
    name=${line#* }
    open[$name]=1
    [[ $name == $current ]] && continue
    print -r -- "session$tab● $name$tab$name"
  done
  # Сессии прошлого запуска (снимок dev -s), ещё не открытые.
  local -A saved
  if [[ -r $snapshot_file ]]; then
    for name in ${(f)"$(awk -F'\t' '$1 == "session" { print $2 }' $snapshot_file)"}; do
      (( ${+open[$name]} )) && continue
      saved[$name]=1
      print -r -- "saved$tab○ $name$tab$name"
    done
  fi
  for dir in $roots; do
    # .worktrees — сессии задач (dev -b): после перезагрузки открываются отсюда.
    dirs+=($dir/*(N/) $dir/*/*/.git(N:h) $dir/.worktrees/*(N/))
  done
  for dir in ${(o)dirs}; do
    name=${${dir:t}//[ .:]/_}   # имя сессии — как его даёт dev
    (( ${+open[$name]} || ${+saved[$name]} )) && continue
    print -r -- "dir$tab  ${dir/#$HOME/~}$tab$dir"
  done
}

preview() {
  case $1 in
    session)
      # Низ экрана сессии: там промпт и последний вывод. $(…) срезает
      # пустые строки под промптом.
      print -r -- "$(tmux capture-pane -ep -t "=$2:")" | tail -n ${FZF_PREVIEW_LINES:-40} ;;
    saved)
      # Окна сессии из снимка с каталогами их панелей.
      awk -F'\t' -v s="$2" -v home="$HOME" '
        $1 == "session" && $2 == s { root = $3; sub("^" home, "~", root); if (root != "") print root; print "" }
        $1 == "window" && $2 == s { printf "%s %s\n", $3, $4 }
        $1 == "pane" && $2 == s { d = $5; sub("^" home, "~", d); printf "    %s%s\n", d, ($6 == "nvim" ? "  nvim" : "") }
      ' $snapshot_file ;;
    *)
      git -C $2 log --oneline --decorate --color=always -12 2>/dev/null && print
      ls -p $2 ;;
  esac
}

case ${1:-} in
  --list)    list; exit ;;
  --preview) preview $2 $3; exit ;;
  --kill)    [[ $2 == session ]] && tmux kill-session -t "=$3"; exit 0 ;;
esac

# --height=100%: серверу tmux достаётся FZF_DEFAULT_OPTS из zshrc (--height
# 50% для Ctrl-R в шелле), а этому списку нужен весь popup.
choice=$(list | fzf --delimiter $tab --with-nth 2 --height=100% --reverse --tiebreak index \
  --prompt 'проект › ' --header 'Enter — перейти (○ — восстановить из снимка) · Ctrl-X — закрыть сессию' \
  --preview "$self --preview {1} {3}" --preview-window right,55% \
  --bind "ctrl-x:execute-silent($self --kill {1} {3})+reload($self --list)") || exit 0

kind=${choice%%$tab*}
target=${choice##*$tab}
case $kind in
  dir)   target=$(cd $target && $dev -d) || exit 1 ;;
  saved) $dev -r -q $target || exit 1 ;;
esac
tmux switch-client -t "=$target"
